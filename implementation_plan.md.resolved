    ├── llm.py                   # HuggingFace LLM wrapper (shared pattern)
    ├── schemas/
    │   ├── __init__.py
    │   └── tech_spec.py         # Pydantic TechSpecArtifact schema
    ├── utils.py                 # Helpers (read_text, write_json)
